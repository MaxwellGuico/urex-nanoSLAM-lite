# Allow task pinning to specific cores
CONFIG_FREERTOS_UNICORE=n

# UART ISR in IRAM so WiFi cache misses don't stall it
CONFIG_UART_ISR_IN_IRAM=y

# Enough stack for main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Tick rate — 1000Hz gives 1ms resolution for vTaskDelayUntil
CONFIG_FREERTOS_HZ=1000

# Seeed Studio XIAO ESP32S3 Sense hardware detected during bench validation
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Development images must not spawn navigation or mission flight tasks
CONFIG_NANOLITE_BENCH_MODE=y
CONFIG_NANOLITE_MAP_EFFECTIVE_RANGE_MM=2000
CONFIG_NANOLITE_MAP_TOF_MAX_AGE_MS=250
CONFIG_NANOLITE_TOF_BENCH_TELEMETRY=y
CONFIG_NANOLITE_TOF_BENCH_INTERVAL_MS=1000
CONFIG_NANOLITE_MAP_SERIAL_DUMP=y
CONFIG_NANOLITE_MAP_DUMP_INTERVAL_S=10

# Never let a VL53L5CX transaction block the ToF polling task indefinitely.
CONFIG_VL53L5CX_I2C_TIMEOUT=y
CONFIG_VL53L5CX_I2C_TIMEOUT_VALUE=100
CONFIG_VL53L5CX_MUXED_BUS=y
CONFIG_VL53L5CX_I2C_WRITE_CHUNK_BYTES=256
CONFIG_VL53L5CX_DISABLE_AMBIENT_PER_SPAD=y
CONFIG_VL53L5CX_DISABLE_NB_SPADS_ENABLED=y
CONFIG_VL53L5CX_DISABLE_SIGNAL_PER_SPAD=y
CONFIG_VL53L5CX_DISABLE_RANGE_SIGMA_MM=y
CONFIG_VL53L5CX_DISABLE_REFLECTANCE_PERCENT=y
CONFIG_VL53L5CX_DISABLE_MOTION_INDICATOR=y
